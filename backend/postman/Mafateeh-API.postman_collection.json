                "header": [
                  { "key": "Authorization", "value": "Bearer {{token}}" },
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"googleTagId\": \"GTM-XXXX\",\n  \"metaTitle\": \"Mafateeh\",\n  \"metaDescription\": \"Company description\",\n  \"metaKeywords\": \"keys\",\n  \"ogImageUrl\": \"https://example.com/og.jpg\"\n}"
                },
                "url": "{{baseUrl}}/api/admin/seo"
              }
            }
          ]
        },
        {
          "name": "Tags & blogs",
