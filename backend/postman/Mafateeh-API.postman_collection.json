{
  "info": {
    "name": "Mafateeh CMS API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Import this file in Postman. Set collection variables: baseUrl (e.g. http://localhost:4000), adminEmail, adminPassword. Run **Admin / Auth / Login** first; copy `token` from the response into the `token` variable (or use a test script to set it)."
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000" },
    { "key": "token", "value": "" },
    { "key": "adminEmail", "value": "admin@mafateeh.local" },
    { "key": "adminPassword", "value": "ChangeMe_Admin123!" },
    { "key": "tagId", "value": "" },
    { "key": "blogCategoryId", "value": "" },
    { "key": "portfolioCategoryId", "value": "" },
    { "key": "serviceCategoryId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    },
    {
      "name": "Public",
      "item": [
        {
          "name": "GET Static site info",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/public/static-site-info" }
        },
        {
          "name": "GET Privacy policy",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/public/privacy-policy" }
        },
        {
          "name": "GET SEO",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/public/seo" }
        },
        {
          "name": "GET Blog categories",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/public/blog-categories" }
        },
        {
          "name": "GET Tags",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/public/tags" }
        },
        {
          "name": "GET Blogs",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/public/blogs" }
        },
        {
          "name": "GET Blog by slug",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/public/blogs/sample-slug" }
        },
        {
          "name": "GET Partners",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/public/partners" }
        },
        {
          "name": "GET Portfolio categories",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/public/portfolio-categories" }
        },
        {
          "name": "GET Portfolios",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/public/portfolios" }
        },
        {
          "name": "GET Portfolio by slug",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/public/portfolios/sample-slug" }
        },
        {
          "name": "GET Testimonials",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/public/testimonials" }
        },
        {
          "name": "GET Service categories",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/public/service-categories" }
        },
        {
          "name": "GET Services",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/public/services" }
        },
        {
          "name": "GET Packages",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/public/packages" }
        },
        {
          "name": "POST Contact",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@example.com\",\n  \"phoneNumber\": \"+966500000000\",\n  \"service\": \"Consulting\",\n  \"inquiry\": \"Hello, I would like more information.\"\n}"
            },
            "url": "{{baseUrl}}/api/public/contact"
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Auth",
          "item": [
            {
              "name": "Login",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "const json = pm.response.json();",
                      "if (json && json.token) { pm.collectionVariables.set('token', json.token); }",
                      "pm.test('Has token', function () { pm.expect(json.token).to.be.a('string'); });"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
                },
                "url": "{{baseUrl}}/api/admin/auth/login"
              }
            },
            {
              "name": "Me",
              "request": {
                "method": "GET",
                "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
                "url": "{{baseUrl}}/api/admin/auth/me"
              }
            }
          ]
        },
        {
          "name": "Upload & health",
          "item": [
            {
              "name": "GET Cloudinary configured",
              "request": {
                "method": "GET",
                "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
                "url": "{{baseUrl}}/api/admin/health/cloudinary"
              }
            },
            {
              "name": "POST Upload image (form-data: file)",
              "request": {
                "method": "POST",
                "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
                "body": {
                  "mode": "formdata",
                  "formdata": [{ "key": "file", "type": "file", "src": "" }]
                },
                "url": "{{baseUrl}}/api/admin/upload?folder=blogs"
              }
            }
          ]
        },
        {
          "name": "Static & legal & SEO",
          "item": [
            {
              "name": "GET Static site info (admin)",
              "request": {
                "method": "GET",
                "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
                "url": "{{baseUrl}}/api/admin/static-site-info"
              }
            },
            {
              "name": "PUT Static site info",
              "request": {
                "method": "PUT",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{token}}" },
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"phoneNumber\": \"+966500000000\",\n  \"email\": \"info@example.com\",\n  \"address\": \"Riyadh\",\n  \"businessHours\": \"Sun–Thu 9–5\",\n  \"latitude\": 24.7136,\n  \"longitude\": 46.6753\n}"
                },
                "url": "{{baseUrl}}/api/admin/static-site-info"
              }
            },
            {
              "name": "GET Privacy (admin)",
              "request": {
                "method": "GET",
