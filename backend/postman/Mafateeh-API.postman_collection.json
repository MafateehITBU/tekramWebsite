                "url": "{{baseUrl}}/api/admin/privacy-policy"
              }
            },
            {
              "name": "PUT Privacy",
              "request": {
                "method": "PUT",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{token}}" },
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": { "mode": "raw", "raw": "{\n  \"content\": \"<p>Updated privacy policy HTML/text.</p>\"\n}" },
                "url": "{{baseUrl}}/api/admin/privacy-policy"
              }
            },
            {
              "name": "GET SEO (admin)",
              "request": {
                "method": "GET",
                "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
                "url": "{{baseUrl}}/api/admin/seo"
              }
            },
            {
              "name": "PUT SEO",
              "request": {
