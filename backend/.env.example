NODE_ENV=development
PORT=4000

POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=tekram

# Optional: full URL instead of POSTGRES_* (password must be URL-encoded if it contains special chars)
# DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/tekram?schema=public

JWT_SECRET=replace-with-at-least-32-characters-long-secret-key
JWT_EXPIRES_IN=8h
CORS_ORIGIN=*

# Optional: image uploads via Cloudinary
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Optional: override default seeded admin
# SEED_ADMIN_EMAIL=admin@tikramarabia.com
# SEED_ADMIN_PASSWORD=ChangeMe_Admin123!

# Contact form email notifications (Gmail: use an App Password, not your account password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@gmail.com
# SMTP_PASS=your_gmail_app_password
# SMTP_FROM=Tikram Contact <noreply@tikramarabia.com>
# CONTACT_NOTIFY_EMAILS=sarasuleiman1234@gmail.com,mohammed.f.zain@gmail.com,khaledalquzai@gmail.com
# ADMIN_DASHBOARD_URL=https://dashboard.tikramarabia.com
